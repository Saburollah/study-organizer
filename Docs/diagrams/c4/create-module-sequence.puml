@startuml CreateStudyModuleSequence
title Lernmodul erstellen – tatsächlicher Ablauf (Level 4)

actor Studierender
participant "Vue ModulesView" as Web
participant "JWT Bearer\nMiddleware" as Auth
participant "ModuleEndpoints" as Endpoint
participant "IModuleHandler\n(ModuleHandler)" as Handler
participant "ApplicationDbContext" as DbContext
database PostgreSQL as Database

Studierender -> Web: Formular für neues Lernmodul absenden
activate Web
Web -> Auth: POST /api/modules\nAuthorization: Bearer <JWT>\n{name, code, description, color}
activate Auth

alt JWT fehlt, ist ungültig oder abgelaufen
  Auth --> Web: 401 Unauthorized
  deactivate Auth
  Web --> Studierender: Anmeldung erforderlich
else JWT ist gültig
  Auth -> Endpoint: Anfrage mit ClaimsPrincipal
  activate Endpoint
  Endpoint -> Endpoint: user.TryGetUserId(out ownerId)
  Endpoint -> Endpoint: RequestValidator.Validate(request)

  alt Eingabe ist ungültig
    Endpoint --> Web: 400 Validation Problem
  else Eingabe ist gültig
    Endpoint -> Handler: CreateAsync(ownerId, name, code,\ndescription, color, cancellationToken)
    activate Handler
    Handler -> Handler: new StudyModule(ownerId, ...)
    Handler -> DbContext: Modules.Add(module)
    DbContext --> Handler: Entität wird verfolgt
    Handler -> DbContext: SaveChangesAsync(cancellationToken)
    activate DbContext
    DbContext -> Database: INSERT INTO modules
    activate Database
    Database --> DbContext: gespeichert
    deactivate Database
    DbContext --> Handler: erfolgreich
    deactivate DbContext
    Handler --> Endpoint: ModuleResult
    deactivate Handler
    Endpoint --> Web: 201 Created + ModuleResponse
  end

  deactivate Endpoint
  deactivate Auth
  Web --> Studierender: Modul in der Liste anzeigen
end

deactivate Web
@enduml
