@startuml StudyOrganizerContainer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Study Organizer – Container (C4 Level 2)

Person(student, "Studierender", "Verwendet Study Organizer im Browser und künftig auf iOS.")

System_Boundary(studyOrganizer, "Study Organizer") {
  Container(web, "Webfrontend", "Vue 3, TypeScript, Vite", "Single-Page-Application mit Dashboard, Profil, Modulen, Aufgaben und Deutsch/Englisch.")
  Container(ios, "iOS-App", "Swift, SwiftUI", "Geplanter nativer Client; noch nicht implementiert.")
  Container(api, "Backend-API", "ASP.NET Core 8, C#, Minimal APIs", "Stellt REST-Endpunkte, Validierung, JWT-Authentifizierung und Geschäftsabläufe bereit.")
  ContainerDb(database, "Datenbank", "PostgreSQL 16", "Speichert Identity-Daten, Profile, Lernmodule, Aufgaben und Migrationen.")
}

Rel(student, web, "Verwendet", "HTTPS")
Rel(student, ios, "Wird künftig verwenden", "iOS")
Rel(web, api, "Ruft geschützte REST-Endpunkte auf", "JSON/HTTPS")
Rel(ios, api, "Wird dieselben REST-Endpunkte aufrufen", "JSON/HTTPS, geplant")
Rel(api, database, "Liest und schreibt", "EF Core/Npgsql")

SHOW_LEGEND()
@enduml
