@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Gast
actor Studierender

rectangle "Study Organizer" {
  usecase "Registrieren" as UC_Register
  usecase "Anmelden" as UC_Login
  usecase "Sprache wechseln" as UC_Language

  usecase "Abmelden" as UC_Logout
  usecase "Dashboard anzeigen" as UC_Dashboard
  usecase "Profil anzeigen" as UC_ProfileRead
  usecase "Profil bearbeiten" as UC_ProfileUpdate
  usecase "Passwort ändern" as UC_Password

  usecase "Lernmodule anzeigen" as UC_ModuleRead
  usecase "Lernmodul erstellen" as UC_ModuleCreate
  usecase "Lernmodul bearbeiten" as UC_ModuleUpdate
  usecase "Lernmodul löschen" as UC_ModuleDelete

  usecase "Aufgaben eines Moduls anzeigen" as UC_TaskRead
  usecase "Aufgabe erstellen" as UC_TaskCreate
  usecase "Aufgabe bearbeiten" as UC_TaskUpdate
  usecase "Aufgabenstatus ändern" as UC_TaskStatus
  usecase "Aufgabe löschen" as UC_TaskDelete
}

Gast --> UC_Register
Gast --> UC_Login
Gast --> UC_Language

Studierender --> UC_Logout
Studierender --> UC_Language
Studierender --> UC_Dashboard
Studierender --> UC_ProfileRead
Studierender --> UC_ProfileUpdate
Studierender --> UC_Password
Studierender --> UC_ModuleRead
Studierender --> UC_ModuleCreate
Studierender --> UC_ModuleUpdate
Studierender --> UC_ModuleDelete
Studierender --> UC_TaskRead
Studierender --> UC_TaskCreate
Studierender --> UC_TaskUpdate
Studierender --> UC_TaskStatus
Studierender --> UC_TaskDelete

UC_ProfileUpdate ..> UC_ProfileRead : <<include>>
UC_TaskRead ..> UC_ModuleRead : <<include>>
UC_TaskCreate ..> UC_TaskRead : <<extend>>
UC_TaskUpdate ..> UC_TaskRead : <<extend>>
UC_TaskStatus ..> UC_TaskRead : <<extend>>
UC_TaskDelete ..> UC_TaskRead : <<extend>>

note right of UC_Login
  Bei Erfolg wird ein JWT ausgegeben.
  Eine gültige Sitzung kann das
  Webfrontend lokal wiederherstellen.
end note

note bottom of UC_ModuleDelete
  Beim Löschen eines Lernmoduls
  werden dessen Aufgaben mitgelöscht.
end note
@enduml
